# Server configuration
PORT=3000
DB_PATH=data/piano.db

# Docker / Arcane Compose configuration
# Host port to expose the app on (default: 3000)
HOST_PORT=3000

# Optional volume mount for SQLite persistence (/app/data inside the container).
# Leave unset/empty to use the default managed Docker volume (piano_data),
# or set a host path for a bind mount (e.g. /srv/piano/data or ./data).
# DATA_VOLUME=/srv/piano/data

# Optional external Docker network (e.g. for a reverse proxy like Traefik/Caddy).
# Leave both unset to use an isolated default bridge network (piano_default).
# To attach to an existing external network, set both:
# EXTERNAL_NETWORK=proxy
# USE_EXTERNAL_NETWORK=true

# Optional AI coaching endpoint (Anthropic Messages API format; set to "off" to disable)
AI_ENDPOINT=http://192.168.0.101:8317/v1/messages
AI_MODEL=claude-haiku-5-5
AI_API_KEY=
AI_TIMEOUT_MS=8000
